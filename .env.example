# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Kaggle (real external Extract source) — kagglehub reads this directly.
# Get a token from https://www.kaggle.com/settings -> API -> Create New Token.
KAGGLE_API_TOKEN=

# Everything below already has docker-compose-friendly defaults (see
# etl/config.py) and only needs overriding for a non-local deployment.

# Object storage (MinIO locally, S3 in AWS)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=datoscope
# S3_SECRET_KEY=datoscope123
# S3_REGION=us-east-1
# RAW_BUCKET=datoscope-raw
# PROCESSED_BUCKET=datoscope-processed

# Warehouse (Postgres locally via docker-compose, RDS in AWS)
# WAREHOUSE_DSN=postgresql+psycopg2://datoscope:datoscope123@localhost:5433/datoscope

# Which Kaggle dataset the Extract stage / Airflow DAG pulls by default
# KAGGLE_DATASET_HANDLE=uciml/iris

# Data quality
# MAX_NULL_FRACTION=0.5
